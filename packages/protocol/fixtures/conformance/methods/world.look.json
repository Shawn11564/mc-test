{
  "method": "world.look",
  "description": "Aim the player: explicit yaw/pitch, or at a world-space point.",
  "request": { "jsonrpc": "2.0", "id": 33, "method": "world.look", "params": { "sessionId": "s_ui_01", "at": { "x": 2.5, "y": -59.5, "z": 0.5 }, "force": true } },
  "responses": [
    {
      "name": "success",
      "envelope": { "jsonrpc": "2.0", "id": 33, "result": { "ok": true, "yaw": -90, "pitch": 0, "position": { "x": 0.5, "y": -60, "z": 0.5 } } }
    },
    {
      "name": "not-joined",
      "envelope": { "jsonrpc": "2.0", "id": 33, "error": { "code": -32004, "message": "Not joined to a world (call world.join first)", "data": { "reason": "WORLD_NOT_READY", "retryable": true } } }
    }
  ]
}
