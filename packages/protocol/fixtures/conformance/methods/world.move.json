{
  "method": "world.move",
  "description": "Primitive movement: hold/release vanilla control states, optionally for a bounded duration. Pathfinding is NOT part of the primitive.",
  "request": { "jsonrpc": "2.0", "id": 34, "method": "world.move", "params": { "sessionId": "s_ui_01", "controls": { "forward": true, "sprint": true }, "durationMs": 400 } },
  "responses": [
    {
      "name": "success",
      "envelope": { "jsonrpc": "2.0", "id": 34, "result": { "ok": true, "position": { "x": 3.1, "y": -60, "z": 0.5 }, "held": [] } }
    },
    {
      "name": "success-stop",
      "envelope": { "jsonrpc": "2.0", "id": 34, "result": { "ok": true, "position": { "x": 3.1, "y": -60, "z": 0.5 }, "held": [], "warnings": ["all control states released"] } }
    },
    {
      "name": "invalid-params",
      "envelope": { "jsonrpc": "2.0", "id": 34, "error": { "code": -32602, "message": "controls.forward must be a boolean", "data": { "reason": "invalidParams", "retryable": false } } }
    }
  ]
}
