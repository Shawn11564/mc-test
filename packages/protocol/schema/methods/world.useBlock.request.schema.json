{
  "additionalProperties": false,
  "description": "MCTP request: world.useBlock",
  "type": "object",
  "required": [
    "jsonrpc",
    "id",
    "method",
    "params"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "id": {
      "description": "JSON-RPC correlation id (string or integer, never null).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "method": {
      "const": "world.useBlock",
      "type": "string"
    },
    "params": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "sessionId",
        "pos"
      ],
      "properties": {
        "sessionId": {
          "description": "Opaque session token from session.create.",
          "type": "string"
        },
        "timeoutMs": {
          "type": "number"
        },
        "requestId": {
          "type": "string"
        },
        "pos": {
          "additionalProperties": false,
          "description": "Block position (integer grid cell).",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "z": {
              "type": "integer"
            }
          }
        },
        "face": {
          "description": "Block face (interaction side).",
          "anyOf": [
            {
              "const": "north",
              "type": "string"
            },
            {
              "const": "south",
              "type": "string"
            },
            {
              "const": "east",
              "type": "string"
            },
            {
              "const": "west",
              "type": "string"
            },
            {
              "const": "up",
              "type": "string"
            },
            {
              "const": "down",
              "type": "string"
            }
          ]
        },
        "hand": {
          "description": "Interaction hand.",
          "anyOf": [
            {
              "const": "main",
              "type": "string"
            },
            {
              "const": "off",
              "type": "string"
            }
          ]
        },
        "sneak": {
          "type": "boolean"
        },
        "cursor": {
          "additionalProperties": false,
          "description": "World-space position (doubles).",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
